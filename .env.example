# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GROQ_API_KEY: Required for Groq LLM API calls.
# Add this in the AI Studio Secrets panel.
# You can provide multiple keys separated by commas for automatic rotation.
GROQ_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Search Keys (Supports rotation: key1,key2,key3)
TAVILY_API_KEY=
SERPAPI_API_KEY=
