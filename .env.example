# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GROQ_API_KEY: Required for Groq LLM API calls.
# Add this in the AI Studio Secrets panel.
# You can provide multiple keys separated by commas for automatic rotation.
GROQ_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Search Keys (Supports rotation: key1,key2,key3)
TAVILY_API_KEY=
SERPAPI_API_KEY=

# ── Security ──────────────────────────────────────────────────────────────
# Master PIN required to access the Web UI and API.
JARVIS_PIN=1234
OWNER_EMAIL=your-email@gmail.com

# ── I.R.I.S. Integration (The Hands) ──────────────────────────────────────
# The public Cloudflare tunnel URL that I.R.I.S. generates on your local PC.
# Start I.R.I.S. on your PC, copy the tunnel URL from its console, and paste it here.
# Example: https://iris-your-tunnel.trycloudflare.com
IRIS_WORMHOLE_URL=

# Shared secret between J.A.R.V.I.S. (cloud) and I.R.I.S. (local PC).
# Must be the same value in BOTH your Render env vars AND I.R.I.S.'s .env file.
# Change this to something private and strong (e.g. a 32-char random string).
IRIS_API_KEY=ironman123

# ── Voice Biometrics Engine (Hugging Face) ────────────────────────────────
# The URL to your private Hugging Face Space running the Voice Engine
# Example: https://digital12-jarvis-voice-engine.hf.space
HUGGINGFACE_VOICE_API_URL=
HUGGINGFACE_VOICE_API_KEY=jarvis_secure_key_123!
